# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# Postgres connection (from Supabase: Project Settings > Database > Connection string)
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password-here

# Full connection string alternative (used by load.py if set)
DATABASE_URL=postgresql://postgres:your-password-here@your-project.supabase.co:5432/postgres

# Maria Island NetCDF download URL, grabbed manually from
# https://portal.aodn.org.au/ (search "Maria Island temperature salinity")
# -- see maria_island/extract.py for step-by-step instructions.
AODN_NETCDF_URL=https://example-thredds-url/IMOS_Maria_Island_long_term_temperature.nc
